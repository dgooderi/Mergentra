{
  "name": "mergentra",
  "version": "1.2.0",
  "description": "A desktop app for exploring local Git history on Windows and Linux.",
  "author": "Mergentra contributors",
  "license": "RPL-1.5",
  "homepage": "https://github.com/dgooderi/Mergentra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgooderi/Mergentra.git"
  },
  "bugs": {
    "url": "https://github.com/dgooderi/Mergentra/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:icons": "node scripts/build-icons.cjs",
    "test:e2e": "playwright test",
    "measure:render": "node scripts/measure-render.cjs",
    "build:win": "electron-builder --win nsis --publish never",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "build:win:portable": "electron-builder --win portable --publish never",
    "build:win:msi": "node scripts/build-msi.cjs",
    "build:win:msi:arm64": "node scripts/build-msi.cjs --arm64",
    "build:linux": "electron-builder --linux AppImage deb rpm --x64 --arm64 --publish never",
    "build:win:arm64": "node scripts/build-win-arm64.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.mergentra.desktop",
    "productName": "Mergentra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/mergentra.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icons/mergentra-256.png",
      "category": "Development",
      "maintainer": "Mergentra contributors <noreply@users.noreply.github.com>",
      "synopsis": "Explore local Git history",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "marked": "^18.1.0"
  }
}
